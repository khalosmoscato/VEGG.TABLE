@using Microsoft.AspNetCore.Components.Routing

<div class="relative w-full bg-primary text-white shadow-lg px-4 py-3 flex items-center justify-between">
    <div class="text-2xl font-bold">VEGG.TABLE</div>

    <button class="md:hidden p-2" @onclick="ToggleNav">
        <span class="bi bi-list text-2xl"></span>
    </button>

    <nav class="@(isExpanded ? "flex flex-col items-center text-center" : "hidden") 
                 md:flex md:flex-row md:flex-1 md:justify-end md:items-center 
                 absolute md:static top-full left-0 w-full bg-primary p-4 gap-6 z-50 shadow-md md:shadow-none">
        
        <NavLink class="nav-link-stable" href="" Match="NavLinkMatch.All" @onclick="CloseNav">
            <span class="bi bi-house-door-fill"></span> Home
        </NavLink>
        
        <NavLink class="nav-link-stable" href="produce" @onclick="CloseNav">
            <span class="bi bi-flower1"></span> My Produce
        </NavLink>
        
        <NavLink class="nav-link-stable" href="analytics" @onclick="CloseNav">
            <span class="bi bi-graph-up"></span> Analytics
        </NavLink>

        @* Theme Toggle integrated into the navigation flow *@
        <div class="flex items-center justify-center p-2">
            <ThemeToggle />
        </div>

        <button class="btn-accent w-full md:w-auto">
            + Add Produce
        </button>
    </nav>
</div>

@code {
    private bool isExpanded = false;
    private void ToggleNav() => isExpanded = !isExpanded;
    private void CloseNav() => isExpanded = false;
}