@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using VEGG.TABLE.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="relative w-full bg-primary text-white shadow-lg px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
        <img src="/images/logo.png" alt="VEGG.TABLE" class="h-16 md:h-24 w-auto object-contain block" />
        <span class="text-xl font-bold hidden min-[320px]:inline-block md:text-2xl whitespace-nowrap">VEGG.TABLE</span>
    </a>

    <button class="lg:hidden p-2" @onclick="ToggleNav">
        <span class="bi bi-list text-2xl"></span>
    </button>

    <nav class="@(isExpanded ? "flex flex-col items-center text-center" : "hidden") 
                 lg:flex lg:flex-row lg:flex-1 lg:justify-end lg:items-center 
                 absolute lg:static top-full left-0 w-full bg-primary p-4 gap-6 z-50 shadow-md lg:shadow-none">
        
        <NavLink class="nav-link-stable" href="" Match="NavLinkMatch.All" @onclick="CloseNav">
            <span class="bi bi-house-door-fill"></span> Home
        </NavLink>
        <NavLink class="nav-link-stable" href="map" @onclick="CloseNav">
            <span class="bi bi-map"></span> Map
        </NavLink>
        <NavLink class="nav-link-stable" href="about" @onclick="CloseNav">
            <span class="bi bi-info-circle"></span> About
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="bi-person-circle nav-link-stable" href="profile" @onclick="CloseNav">Profile</NavLink>
            </Authorized>
        </AuthorizeView>

        <div class="flex items-center justify-center p-2">
            <ThemeToggle />
        </div>

        <AuthorizeView>
            <Authorized>
                <button class="login-btn-custom" @onclick="Logout">Logout</button>
            </Authorized>
            <NotAuthorized>
                <a href="login" class="login-btn-custom">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool isExpanded = false;
    private void ToggleNav() => isExpanded = !isExpanded;
    private void CloseNav() => isExpanded = false;

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        ((AuthStateProvider)AuthStateProvider).NotifyUserAuthentication(null!);
        Nav.NavigateTo("/login");
    }
}