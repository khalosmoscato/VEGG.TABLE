@page "/sellers"
@using VEGG.TABLE.Core.Entities
@using VEGG.TABLE.Core.Entities.DTOs
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav

<div class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold mb-6 text-center">Local Producers</h2>

    @if (farms == null || users == null)
    {
        <p class="text-center">Loading...</p>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var farm in farms)
            {
                <div class="bg-primary p-6 rounded-2xl shadow-sm hover:shadow-lg transition-all">
                    <h4 class="text-xl font-bold text-white text-center mb-6">@farm.Name</h4>
                    <button class="w-full bg-accent text-white font-bold py-2 rounded-md transition"
                        onmouseover="this.style.backgroundColor='#EA580C'"
                        onmouseout="this.style.backgroundColor='#F97316'"
                            @onclick='() => Nav.NavigateTo($"/user-shop/{farm.Id}")'>
                        View Profile
                    </button>
                </div>
            }

            @foreach (var user in users)
            {
                <div class="bg-primary p-6 rounded-2xl shadow-sm hover:shadow-lg transition-all">
                    <h4 class="text-xl font-bold text-white text-center mb-6">@user.Name</h4>
                    <button class="w-full bg-accent text-white font-bold py-2 rounded-md transition"
                        onmouseover="this.style.backgroundColor='#EA580C'"
                        onmouseout="this.style.backgroundColor='#F97316'"
                            @onclick='() => Nav.NavigateTo($"/user-shop/{user.Id}")'>
                        View Profile
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
	private List<Farm>? farms;
	private List<UserResponseDTO>? users;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var http = ClientFactory.CreateClient("PublicAPI");

			farms = await http.GetFromJsonAsync<List<Farm>>("api/farms");
			users = await http.GetFromJsonAsync<List<UserResponseDTO>>("api/user/sellers");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading data: {ex.Message}");
		}
		finally
		{
			// Force re-render once fetching is attempted
			StateHasChanged();
		}
	}
}
