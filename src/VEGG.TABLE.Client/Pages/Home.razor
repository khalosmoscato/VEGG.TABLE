<PageTitle>VEGG.TABLE</PageTitle>
@page "/"
@using VEGG.TABLE.Core.Entities
@using VEGG.TABLE.Client.Components
@inject IHttpClientFactory ClientFactory

@* Hero / Welcome Section *@
<div class="bg-emerald-800 text-white p-8 rounded-lg mb-8 shadow-md text-center">
    <h1 class="text-3xl font-bold mb-2">Welcome to VEGG.TABLE</h1>
    <p class="max-w-2xl mx-auto">
        Connecting local, sustainable produce directly to your community. 
        Precision-grown, farm-fresh, and ready for you to collect.
    </p>
</div>

@* Divider Line *@
<div class="border-t border-primary my-8"></div>

@* How It Works Section *@
<div class="mt-12 mb-12">
    <h2 class="text-2xl font-bold mb-6 text-center">How VEGG.TABLE Works</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-white p-6 rounded-lg border border-emerald-200 shadow-sm text-center">
            <div class="text-orange-500 text-3xl mb-4">🛒</div>
            <h4 class="font-bold text-emerald-900 mb-2">1. Request</h4>
            <p class="text-emerald-700 text-sm">Browse fresh, local produce and click "Request to Buy" on what you need.</p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-emerald-200 shadow-sm text-center">
            <div class="text-orange-500 text-3xl mb-4">🤝</div>
            <h4 class="font-bold text-emerald-900 mb-2">2. Connect</h4>
            <p class="text-emerald-700 text-sm">We put you in touch with the local grower to arrange the final details.</p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-emerald-200 shadow-sm text-center">
            <div class="text-orange-500 text-3xl mb-4">🥕</div>
            <h4 class="font-bold text-emerald-900 mb-2">3. Collect</h4>
            <p class="text-emerald-700 text-sm">Pick up your fresh goods directly from the farm or community hub.</p>
        </div>

    </div>
</div>

@* Divider Line *@
<div class="border-t border-primary my-8"></div>

@* Search and Filter Section *@
<div class="mb-6 flex flex-wrap gap-4 items-end justify-center">
    <div>
        <label for="searchInput" class="block text-base font-medium text-accent mb-1 text-center w-full">Search:</label>
        <input id="searchInput" type="text" @oninput="OnSearchInput" placeholder="Search produce..." 
               class="bg-white border border-primary text-primary font-semibold placeholder:font-semibold placeholder:text-primary text-center text-base rounded-lg p-2.5 w-64 focus:ring-2 focus:ring-emerald-500 outline-none" />
    </div>

    <div>
        <label for="categorySelect" class="block text-base font-medium text-accent mb-1 text-center w-full">Category:</label>
        <select id="categorySelect" @onchange="OnCategoryChange" 
                class="bg-white border border-primary text-primary text-center font-semibold text-base rounded-lg p-2.5 w-64 outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="all">All Produce</option>
            <option value="fruit">Fruit</option>
            <option value="vegetable">Vegetable</option>
        </select>
    </div>
</div>

@* Product Feed *@
<h2 class="text-2xl font-bold mb-6 text-center">Available Produce</h2>

@if (filteredList == null)
{
    <p><em>Loading fresh produce...</em></p>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @foreach (var item in filteredList)
        {
            <ProduceCard Item="item" />
        }
    </div>
}

@code {
    private List<Produce>? allProduce;
    private List<Produce>? filteredList;
    private string searchTerm = "";
    private string selectedCategory = "all";

    private readonly string[] FruitNames = { "Plums", "Apples", "Bananas", "Strawberries", "Oranges" };
    private readonly string[] VegNames = { "Carrots", "Tomatoes", "Potatoes", "Lettuce", "Cucumbers" };

    protected override async Task OnInitializedAsync()
    {
        // Using PublicAPI client to avoid sending auth headers for this public data
        var http = ClientFactory.CreateClient("PublicAPI");
        allProduce = await http.GetFromJsonAsync<List<Produce>>("api/produce");
        filteredList = allProduce;
    }

    private void ApplyFilters()
    {
        filteredList = allProduce?.Where(p => 
            MatchesCategory(p.Name) &&
            (string.IsNullOrWhiteSpace(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private bool MatchesCategory(string name)
    {
        if (selectedCategory == "fruit") 
            return FruitNames.Contains(name, StringComparer.OrdinalIgnoreCase);
            
        if (selectedCategory == "vegetable") 
            return VegNames.Contains(name, StringComparer.OrdinalIgnoreCase);
            
        return true; 
    }

    private void OnCategoryChange(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "all";
        ApplyFilters();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }
}