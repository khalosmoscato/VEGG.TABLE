<PageTitle>Map</PageTitle>

@page "/map"
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS

<div class="flex h-[600px] w-full">
    
    <div class="w-1/3 overflow-y-auto border-r border-gray-200 bg-white">
        <h2 class="p-4 text-xl font-bold text-green-800">Available Farms</h2>
        <div id="farm-list"></div> </div>

    <div id="farmMap" class="w-2/3 h-[600px] border border-gray-300 rounded-lg shadow-sm"></div>
</div>

@code {
    private List<Farm>? farms;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var http = ClientFactory.CreateClient("PublicAPI");
            farms = await http.GetFromJsonAsync<List<Farm>>("/api/farms");

            if (farms != null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapHelper.js");
                await module.InvokeVoidAsync("initializeMap", "farmMap", farms);
            }
        }
    }
}
