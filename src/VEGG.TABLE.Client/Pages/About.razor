@page "/about"

<div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-accent mb-6">About VEGG.TABLE</h1>
    
    <div class="bg-primary p-8 rounded-lg shadow-sm ">
        <h2 class="text-xl text-accent font-semibold mb-4">Our Mission</h2>
        <p class="text-white mb-6">
            VEGG.TABLE was created to bridge the gap between local growers and their communities. 
            We believe that high-quality, sustainable produce should be accessible, 
            transparent, and grown with care.
        </p>

        <h2 class="text-xl text-accent font-semibold mb-4">How it works</h2>
        <p class="text-white mb-4">
            By connecting you directly with local growers, we reduce food miles, 
            support local economies, and ensure you get the freshest ingredients 
            possible. Simply browse, request to buy, and coordinate your collection 
            with the grower.
        </p>
    </div>
</div>