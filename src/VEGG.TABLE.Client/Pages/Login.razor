@page "/login"

<div class="max-w-md mx-auto p-6 mt-10">
    <div class="bg-primary p-8 rounded-lg shadow-sm">
        <h1 class="text-2xl font-bold text-accent mb-6">Sign In</h1>
        
        <div class="space-y-4">
            <div>
                <label class="block text-white text-sm font-medium mb-1">Email</label>
                <input type="email" class="w-full text-white p-2 rounded border border-gray-300" placeholder="your@email.com" />
            </div>
            
            <div>
                <label class="block text-white text-sm font-medium mb-1">Password</label>
                <input type="password" class="w-full text-white p-2 rounded border border-gray-300" placeholder="••••••••" />
            </div>

            <button class="w-full bg-accent text-white font-bold py-2 rounded hover:bg-orange-600 transition-colors mt-4">
                Login
            </button>
        </div>
        
        <p class="text-white text-sm mt-4 text-center">
            Don't have an account? <a href="register" class="text-accent underline">Sign up here</a>
        </p>
    </div>
</div>