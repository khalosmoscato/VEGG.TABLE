@page "/register"
@using VEGG.TABLE.Core.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>Register Account</h3>

<EditForm Model="@user" OnValidSubmit="HandleRegister">
	<div class="mb-3">
		<label>Full Name</label>
		<InputText @bind-Value="user.Name" class="form-control" placeholder="Enter name" />
	</div>
	<div class="mb-3">
		<label>Email Address</label>
		<InputText @bind-Value="user.Email" class="form-control" placeholder="Enter email" />
	</div>
	<div class="mb-3">
		<label>Password</label>
		<InputText @bind-Value="user.Password" type="password" class="form-control" placeholder="Enter password" />
	</div>
	<div class="mb-3">
		<label>I am a...</label>
		<InputSelect @bind-Value="user.UserType" class="form-control">
			<option value="@UserType.Buyer">Buyer</option>
			<option value="@UserType.Seller">Seller</option>
		</InputSelect>
	</div>
	<button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@code {
	private UserDTO user = new UserDTO { Name = "", Email = "", Password = "" };

	private async Task HandleRegister()
	{
		try
		{
			// The route must match [Route("api/[controller]")] in UserController
			var response = await Http.PostAsJsonAsync("api/user", user);

			if (response.IsSuccessStatusCode)
			{
				await JS.InvokeVoidAsync("alert", "Registration successful!");
				Navigation.NavigateTo("/login");
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				await JS.InvokeVoidAsync("alert", $"Registration failed: {error}");
			}
		}
		catch (Exception ex)
		{
			await JS.InvokeVoidAsync("alert", $"System error: {ex.Message}");
		}
	}
}