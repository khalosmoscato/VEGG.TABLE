@page "/register"
@using VEGG.TABLE.Core.Entities
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Remove 'bg-gray-50' to make the background transparent/match your site's main theme *@
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">

	@* Card: Removed border-2 border-[#E98226] to eliminate the orange outline *@
	<div class="max-w-md w-full space-y-8 bg-[#175A36] p-10 rounded-xl shadow-lg">
		<div>
			<h2 class="mt-6 text-center text-3xl font-extrabold text-[#E98226]">Sign Up</h2>
			<p class="mt-2 text-center text-sm text-white">
				Create an account as a Buyer, Seller, or Admin
			</p>
		</div>

		<EditForm Model="@user" OnValidSubmit="HandleRegister" class="mt-8 space-y-6">
			<div class="rounded-md shadow-sm -space-y-px">
				<div class="mb-4">
					<label class="block text-sm font-medium text-[#E98226]">Full Name</label>
					@* Simplified input: Removed border-2 border-[#E98226] *@
					<InputText @bind-Value="user.Name" class="appearance-none rounded-md relative block w-full px-3 py-2 bg-[#44A377] text-white focus:outline-none focus:ring-2 focus:ring-[#E98226] sm:text-sm" placeholder="John Doe" />
				</div>
				<div class="mb-4">
					<label class="block text-sm font-medium text-[#E98226]">Email Address</label>
					<InputText @bind-Value="user.Email" class="appearance-none rounded-md relative block w-full px-3 py-2 bg-[#44A377] text-white focus:outline-none focus:ring-2 focus:ring-[#E98226] sm:text-sm" placeholder="email@example.com" />
				</div>
				<div class="mb-4">
					<label class="block text-sm font-medium text-[#E98226]">Password</label>
					<InputText @bind-Value="user.Password" type="password" class="appearance-none rounded-md relative block w-full px-3 py-2 bg-[#44A377] text-white focus:outline-none focus:ring-2 focus:ring-[#E98226] sm:text-sm" placeholder="••••••••" />
				</div>
				<div class="mb-6">
					<label class="block text-sm font-medium text-[#E98226]">Account Type</label>
					@* Simplified select: Removed border-2 border-[#E98226] *@
					<InputSelect @bind-Value="user.UserType" class="mt-1 block w-full pl-3 pr-10 py-2 text-base bg-[#44A377] text-white focus:outline-none focus:ring-2 focus:ring-[#E98226] sm:text-sm rounded-md">
						<option value="@UserType.Buyer">Buyer</option>
						<option value="@UserType.Seller">Seller</option>
						<option value="@UserType.Admin">Admin</option>
					</InputSelect>
				</div>
			</div>

			<div>
				<button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-[#E98226] hover:bg-[#F2A45C] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#E98226]">
					Register Account
				</button>
			</div>

			<div class="text-center mt-6">
				<span class="text-white text-sm">Already have an account?</span>
				<a href="/login" class="font-medium text-[#E98226] hover:text-[#F2A45C] text-sm ml-1 transition duration-150">Sign in here</a>
			</div>
		</EditForm>
	</div>
</div>

@code {
	private UserDTO user = new UserDTO { Name = "", Email = "", Password = "" };

	private async Task HandleRegister()
	{
		var client = ClientFactory.CreateClient("PublicAPI");
		var response = await client.PostAsJsonAsync("api/user", user);

		if (response.IsSuccessStatusCode)
		{
			Navigation.NavigateTo("/login");
		}
		else
		{
			await JS.InvokeVoidAsync("alert", "Registration failed. Please check your inputs.");
		}
	}
}