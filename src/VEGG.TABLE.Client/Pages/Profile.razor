@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using VEGG.TABLE.Core.Entities.DTOs
@using VEGG.TABLE.Client.Services
@using System.IdentityModel.Tokens.Jwt
@inject IHttpClientFactory ClientFactory
@inject AuthenticationStateProvider AuthStateProvider

<div class="max-w-3xl mx-auto px-8 py-8">
    <h1 class="text-4xl font-bold mb-6 text-center">Your Profile</h1>

    @if (userProfile == null)
    {
        <p class="text-center text-accent"><em>Loading your profile...</em></p>
    }
    else if (isEditing)
    {
        <div class="bg-primary shadow rounded-lg p-6 space-y-4 text-center">
            <div>
                <label class="block text-sm font-semibold text-white mb-1">Name</label>
                <input @bind="editName"
                       class="w-full border border-emerald-700 rounded-lg px-3 py-2
                              bg-emerald-800 text-white text-center placeholder-emerald-300
                              focus:outline-none focus:ring-2 focus:ring-accent" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-white mb-1">Email</label>
                <input @bind="editEmail" type="email"
                       class="w-full border border-emerald-700 rounded-lg px-3 py-2
                              bg-emerald-800 text-white text-center placeholder-emerald-300
                              focus:outline-none focus:ring-2 focus:ring-accent" />
            </div>

            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <p class="text-sm @feedbackColour">@feedbackMessage</p>
            }

            <div class="flex gap-3 pt-2 justify-center">
                <button @onclick="SaveChanges" class="btn-accent">Save Changes</button>
                <button @onclick="CancelEdit"
                        class="px-4 py-2 rounded-lg border border-emerald-600
                               text-white hover:bg-emerald-800 transition-colors duration-200">
                    Cancel
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-primary shadow rounded-lg p-6 space-y-2 text-center">
            <p class="text-white"><strong>Name:</strong> @userProfile.Name</p>
            <p class="text-white"><strong>Email:</strong> @userProfile.Email</p>
            <p class="text-white"><strong>Account Type:</strong> @userProfile.UserType</p>

            <div class="flex gap-3 pt-4 justify-center">
                <button @onclick="StartEdit" class="btn-accent">Edit Profile</button>
            </div>
        </div>

        @if (userProfile.UserType == UserType.Seller)
        {
            <div class="mt-10">
                <h2 class="text-4xl font-bold mb-4 text-center">Your Produce</h2>

                @if (produceList == null)
                {
                    <p class="text-center text-gray-600 dark:text-gray-300"><em>Loading your produce...</em></p>
                }
                else if (!produceList.Any())
                {
                    <p class="text-center text-gray-600 dark:text-gray-300">You have no produce listings yet.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var item in produceList)
                        {
                            @if (editingProduceId == item.ProduceId)
                            {
                                <div class="bg-primary shadow rounded-lg p-6 space-y-3">
                                    <p class="text-white font-semibold text-center">
                                        Editing: @GetProduceEmoji(item.Name) @item.Name
                                    </p>
                                    <div>
                                        <label class="block text-sm font-semibold text-white mb-1">Name</label>
                                        <input @bind="editProdName"
                                               class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                                      bg-emerald-800 text-white placeholder-emerald-300
                                                      focus:outline-none focus:ring-2 focus:ring-accent" />
                                    </div>
                                    <div class="flex gap-3">
                                        <div class="flex-1">
                                            <label class="block text-sm font-semibold text-white mb-1">Price (£)</label>
                                            <input @bind="editProdPrice" type="number" step="0.01"
                                                   class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                                          bg-emerald-800 text-white placeholder-emerald-300
                                                          focus:outline-none focus:ring-2 focus:ring-accent" />
                                        </div>
                                        <div class="flex-1">
                                            <label class="block text-sm font-semibold text-white mb-1">Stock</label>
                                            <input @bind="editProdStock" type="number"
                                                   class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                                          bg-emerald-800 text-white placeholder-emerald-300
                                                          focus:outline-none focus:ring-2 focus:ring-accent" />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-white mb-1">Description</label>
                                        <textarea @bind="editProdDescription" rows="2"
                                                  class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                                         bg-emerald-800 text-white placeholder-emerald-300
                                                         focus:outline-none focus:ring-2 focus:ring-accent" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(produceFeedbackMessage))
                                    {
                                        <p class="text-sm text-center @produceFeedbackColour">@produceFeedbackMessage</p>
                                    }

                                    <div class="flex gap-3 justify-center pt-2">
                                        <button @onclick="() => SaveProduceChanges(item.ProduceId)" class="btn-accent">
                                            Save Changes
                                        </button>
                                        <button @onclick="CancelProduceEdit"
                                                class="px-4 py-2 rounded-lg border border-emerald-600
                                                       text-white hover:bg-emerald-800 transition-colors duration-200">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="bg-primary shadow rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <span class="text-3xl">@GetProduceEmoji(item.Name)</span>
                                        <div class="text-left">
                                            <p class="font-semibold text-white">@item.Name</p>
                                            <p class="text-sm text-emerald-200">£@item.Price · Stock: @item.Stock</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-xs px-2 py-1 rounded-full font-medium whitespace-nowrap
                                                     @(item.IsOnSale ? "bg-green-300 text-green-900" : "bg-white/20 text-white")">
                                            @(item.IsOnSale ? "On Sale" : "Not On Sale")
                                        </span>
                                        <button @onclick="() => StartProduceEdit(item)"
                                                style="background-color: rgba(255,255,255,0.1); transition: background-color 0.2s;"
                                                onmouseover="this.style.backgroundColor='#059669'"
                                                onmouseout="this.style.backgroundColor='rgba(255,255,255,0.1)'"
                                                class="text-xs px-3 py-1 rounded-lg text-white border border-white/30 whitespace-nowrap">
                                            Edit
                                        </button>
                                        <button @onclick="() => ToggleSale(item)"
                                                style="background-color: rgba(255,255,255,0.1); transition: background-color 0.2s;"
                                                onmouseover="this.style.backgroundColor='#059669'"
                                                onmouseout="this.style.backgroundColor='rgba(255,255,255,0.1)'"
                                                class="text-xs px-3 py-1 rounded-lg text-white border border-white/30 whitespace-nowrap">
                                            @(item.IsOnSale ? "Remove from Sale" : "Put On Sale")
                                        </button>
                                        <button @onclick="() => DeleteProduce(item.ProduceId)"
                                                style="background-color: #ef4444; transition: background-color 0.2s;"
                                                onmouseover="this.style.backgroundColor='#b91c1c'"
                                                onmouseout="this.style.backgroundColor='#ef4444'"
                                                class="text-xs px-3 py-1 rounded-lg text-white whitespace-nowrap">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                @* Add Produce Form *@
                @if (isAddingProduce)
                {
                    <div class="bg-primary shadow rounded-lg p-6 space-y-3 mt-4">
                        <p class="text-white font-semibold text-center">Add New Produce</p>

                        <div>
                            <label class="block text-sm font-semibold text-white mb-1">Name</label>
                            <select @bind="newProdName"
                                    class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                           bg-emerald-800 text-white focus:outline-none focus:ring-2 focus:ring-accent">
                                <option value="">-- Select a produce --</option>
                                <option value="Plums">🍑 Plums</option>
                                <option value="Apples">🍎 Apples</option>
                                <option value="Bananas">🍌 Bananas</option>
                                <option value="Carrots">🥕 Carrots</option>
                                <option value="Tomatoes">🍅 Tomatoes</option>
                                <option value="Potatoes">🥔 Potatoes</option>
                                <option value="Strawberries">🍓 Strawberries</option>
                                <option value="Lettuce">🥬 Lettuce</option>
                                <option value="Oranges">🍊 Oranges</option>
                                <option value="Cucumbers">🥒 Cucumbers</option>
                                <option value="Broccoli">🥦 Broccoli</option>
                            </select>
                        </div>

                        <div class="flex gap-3">
                            <div class="flex-1">
                                <label class="block text-sm font-semibold text-white mb-1">Price (£)</label>
                                <input @bind="newProdPrice" type="number" step="0.01" min="0"
                                       class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                              bg-emerald-800 text-white placeholder-emerald-300
                                              focus:outline-none focus:ring-2 focus:ring-accent" />
                            </div>
                            <div class="flex-1">
                                <label class="block text-sm font-semibold text-white mb-1">Stock</label>
                                <input @bind="newProdStock" type="number" min="0"
                                       class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                              bg-emerald-800 text-white placeholder-emerald-300
                                              focus:outline-none focus:ring-2 focus:ring-accent" />
                            </div>
                            <div class="flex-1">
                                <label class="block text-sm font-semibold text-white mb-1">Weight (kg)</label>
                                <input @bind="newProdWeight" type="number" step="0.01" min="0"
                                       class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                              bg-emerald-800 text-white placeholder-emerald-300
                                              focus:outline-none focus:ring-2 focus:ring-accent" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-white mb-1">Category</label>
                            <select @bind="newProdCategory"
                                    class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                           bg-emerald-800 text-white focus:outline-none focus:ring-2 focus:ring-accent">
                                <option value="@Category.LeafyGreens">Leafy Greens (Spinach, Kale, Lettuce)</option>
                                <option value="@Category.Cruciferous">Cruciferous (Broccoli, Cauliflower)</option>
                                <option value="@Category.RootAndTuber">Root & Tuber (Carrots, Potatoes)</option>
                                <option value="@Category.Allium">Allium (Onions, Garlic)</option>
                                <option value="@Category.FruitVegetables">Fruit Vegetables (Tomatoes, Cucumbers)</option>
                                <option value="@Category.PodsAndSeeds">Pods & Seeds (Peas, Green Beans)</option>
                                <option value="@Category.StemsAndShoots">Stems & Shoots (Asparagus, Celery)</option>
                                <option value="@Category.Mushrooms">Mushrooms</option>
                                <option value="@Category.Herbs">Herbs (Parsley, Basil)</option>
                                <option value="@Category.Unkown">Other</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-white mb-1">Description</label>
                            <textarea @bind="newProdDescription" rows="2"
                                      class="w-full border border-emerald-700 rounded-lg px-3 py-2
                                             bg-emerald-800 text-white placeholder-emerald-300
                                             focus:outline-none focus:ring-2 focus:ring-accent"
                                      placeholder="Describe your produce..." />
                        </div>

                        <div class="flex items-center gap-2">
                            <input type="checkbox" @bind="newProdIsOnSale" id="isOnSale"
                                   class="w-4 h-4 accent-accent" />
                            <label for="isOnSale" class="text-sm text-white">List immediately for sale</label>
                        </div>

                        @if (!string.IsNullOrEmpty(addProduceFeedbackMessage))
                        {
                            <p class="text-sm text-center @addProduceFeedbackColour">@addProduceFeedbackMessage</p>
                        }

                        <div class="flex gap-3 justify-center pt-2">
                            <button @onclick="SubmitNewProduce" class="btn-accent">
                                Add Produce
                            </button>
                            <button @onclick="CancelAddProduce"
                                    class="px-4 py-2 rounded-lg border border-emerald-600
                                           text-white hover:bg-emerald-800 transition-colors duration-200">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex justify-center mt-4">
                        <button @onclick="() => isAddingProduce = true" class="btn-accent">
                            + Add New Produce
                        </button>
                    </div>
                }
            </div>
        }

        @* Liked Produce - shown for ALL user types *@
        <div class="mt-10">
            <h2 class="text-4xl font-bold mb-4 text-center">Your Liked Produce</h2>

            @if (likedProduce == null)
            {
                <p class="text-center dark:text-gray-400"><em>Loading your liked produce...</em></p>
            }
            else if (!likedProduce.Any())
            {
                <p class="text-center dark:text-gray-400">You haven't liked any produce yet.</p>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var item in likedProduce)
                    {
                        <div class="bg-primary shadow rounded-lg p-4 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="text-3xl">@GetProduceEmoji(item.Name)</span>
                                <div class="text-left">
                                    <p class="font-semibold text-white">@item.Name</p>
                                    <p class="text-sm text-emerald-200">£@item.Price · Stock: @item.Stock</p>
                                </div>
                            </div>
                            <button @onclick="() => UnlikeFromProfile(item.ProduceId)"
                                    style="background-color: #ef4444; transition: background-color 0.2s;"
                                    onmouseover="this.style.backgroundColor='#b91c1c'"
                                    onmouseout="this.style.backgroundColor='#ef4444'"
                                    class="text-xs px-3 py-1 rounded-lg text-white whitespace-nowrap">
                                Unlike
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private UserResponseDTO? userProfile;
    private List<Produce>? produceList;
    private List<Produce>? likedProduce;
    private bool isEditing = false;
    private int userId = 0;

    // Profile edit fields
    private string editName = "";
    private string editEmail = "";
    private string feedbackMessage = "";
    private string feedbackColour = "";

    // Produce edit fields
    private int? editingProduceId = null;
    private string editProdName = "";
    private double editProdPrice = 0;
    private int editProdStock = 0;
    private string editProdDescription = "";
    private string produceFeedbackMessage = "";
    private string produceFeedbackColour = "";

    // Add produce fields
    private bool isAddingProduce = false;
    private string newProdName = "";
    private double newProdPrice = 0;
    private int newProdStock = 0;
    private double newProdWeight = 0;
    private Category newProdCategory = Category.Unkown;
    private string newProdDescription = "";
    private bool newProdIsOnSale = false;
    private string addProduceFeedbackMessage = "";
    private string addProduceFeedbackColour = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst("nameid")?.Value;
        if (!string.IsNullOrEmpty(idClaim))
            int.TryParse(idClaim, out userId);

        await LoadProfile();
        await LoadProduce();
        await LoadLikedProduce();
    }

    private async Task LoadProfile()
    {
        var http = ClientFactory.CreateClient("ProtectedAPI");
        try
        {
            userProfile = await http.GetFromJsonAsync<UserResponseDTO>("api/user/profile");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
    }

    private async Task LoadProduce()
    {
        if (userId == 0) return;
        var http = ClientFactory.CreateClient("ProtectedAPI");
        try
        {
            produceList = await http.GetFromJsonAsync<List<Produce>>($"api/produce/seller/all/{userId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading produce: {ex.Message}");
        }
    }

    private async Task LoadLikedProduce()
    {
        if (userId == 0) return;
        var http = ClientFactory.CreateClient("ProtectedAPI");
        try
        {
            var likes = await http.GetFromJsonAsync<List<UserProduceLike>>($"api/likes/user/{userId}");
            if (likes != null && likes.Any())
            {
                var publicHttp = ClientFactory.CreateClient("PublicAPI");
                var allProduce = await publicHttp.GetFromJsonAsync<List<Produce>>("api/produce");
                var likedIds = likes.Select(l => l.ProduceId).ToHashSet();
                likedProduce = allProduce?.Where(p => likedIds.Contains(p.ProduceId)).ToList() ?? new();
            }
            else
            {
                likedProduce = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading liked produce: {ex.Message}");
            likedProduce = new();
        }
    }

    private async Task UnlikeFromProfile(int produceId)
    {
        var http = ClientFactory.CreateClient("ProtectedAPI");
        try
        {
            var response = await http.DeleteAsync($"api/likes?userId={userId}&produceId={produceId}");
            if (response.IsSuccessStatusCode)
                await LoadLikedProduce();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error unliking produce: {ex.Message}");
        }
        StateHasChanged();
    }

    private void StartEdit()
    {
        editName = userProfile?.Name ?? "";
        editEmail = userProfile?.Email ?? "";
        feedbackMessage = "";
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        feedbackMessage = "";
    }

    private async Task SaveChanges()
    {
        if (userProfile == null || userId == 0) return;

        var http = ClientFactory.CreateClient("ProtectedAPI");

        var updatedUser = new UserDTO
        {
            Name = editName,
            Email = editEmail,
            Password = ""
        };

        try
        {
            var response = await http.PutAsJsonAsync($"api/user/{userId}", updatedUser);

            if (response.IsSuccessStatusCode)
            {
                feedbackMessage = "Profile updated successfully!";
                feedbackColour = "text-green-400";
                await LoadProfile();
                StateHasChanged();
                await Task.Delay(1200);
                isEditing = false;
            }
            else
            {
                feedbackMessage = "Something went wrong. Please try again.";
                feedbackColour = "text-red-400";
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error: {ex.Message}";
            feedbackColour = "text-red-400";
            Console.WriteLine($"Error updating profile: {ex.Message}");
        }

        StateHasChanged();
    }

    private void StartProduceEdit(Produce item)
    {
        editingProduceId = item.ProduceId;
        editProdName = item.Name;
        editProdPrice = item.Price;
        editProdStock = item.Stock;
        editProdDescription = item.Description;
        produceFeedbackMessage = "";
    }

    private void CancelProduceEdit()
    {
        editingProduceId = null;
        produceFeedbackMessage = "";
    }

    private async Task SaveProduceChanges(int produceId)
    {
        var http = ClientFactory.CreateClient("ProtectedAPI");

        var dto = new ProduceDTO
        {
            Name = editProdName,
            Price = editProdPrice,
            Stock = editProdStock,
            Description = editProdDescription
        };

        try
        {
            var response = await http.PatchAsJsonAsync($"api/produce/{produceId}", dto);

            if (response.IsSuccessStatusCode)
            {
                produceFeedbackMessage = "Updated successfully!";
                produceFeedbackColour = "text-green-400";
                await LoadProduce();
                StateHasChanged();
                await Task.Delay(1200);
                editingProduceId = null;
            }
            else
            {
                produceFeedbackMessage = "Something went wrong. Please try again.";
                produceFeedbackColour = "text-red-400";
            }
        }
        catch (Exception ex)
        {
            produceFeedbackMessage = $"Error: {ex.Message}";
            produceFeedbackColour = "text-red-400";
            Console.WriteLine($"Error updating produce: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task ToggleSale(Produce item)
    {
        var http = ClientFactory.CreateClient("ProtectedAPI");
        var dto = new ProduceDTO { IsOnSale = !item.IsOnSale };
        try
        {
            var response = await http.PatchAsJsonAsync($"api/produce/{item.ProduceId}", dto);
            if (response.IsSuccessStatusCode)
                await LoadProduce();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling sale: {ex.Message}");
        }
    }

    private async Task DeleteProduce(int produceId)
    {
        var http = ClientFactory.CreateClient("ProtectedAPI");
        try
        {
            var response = await http.DeleteAsync($"api/produce/{produceId}");
            if (response.IsSuccessStatusCode)
                await LoadProduce();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting produce: {ex.Message}");
        }
    }

    private void CancelAddProduce()
    {
        isAddingProduce = false;
        newProdName = "";
        newProdPrice = 0;
        newProdStock = 0;
        newProdWeight = 0;
        newProdCategory = Category.Unkown;
        newProdDescription = "";
        newProdIsOnSale = false;
        addProduceFeedbackMessage = "";
    }

    private async Task SubmitNewProduce()
    {
        if (string.IsNullOrWhiteSpace(newProdName))
        {
            addProduceFeedbackMessage = "Please select a produce name.";
            addProduceFeedbackColour = "text-red-400";
            StateHasChanged();
            return;
        }

        var http = ClientFactory.CreateClient("ProtectedAPI");

        var dto = new CreateProduceDTO
        {
            Name = newProdName,
            Price = newProdPrice,
            Stock = newProdStock,
            Weight = newProdWeight,
            Category = newProdCategory,
            Description = newProdDescription,
            PhotograghPath = "",
            IsOnSale = newProdIsOnSale,
            UserId = userId
        };

        try
        {
            var response = await http.PostAsJsonAsync("api/produce", dto);

            if (response.IsSuccessStatusCode)
            {
                addProduceFeedbackMessage = "Produce added successfully!";
                addProduceFeedbackColour = "text-green-400";
                await LoadProduce();
                StateHasChanged();
                await Task.Delay(1200);
                CancelAddProduce();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                addProduceFeedbackMessage = "Something went wrong. Please try again.";
                addProduceFeedbackColour = "text-red-400";
                Console.WriteLine($"Add produce failed: {error}");
            }
        }
        catch (Exception ex)
        {
            addProduceFeedbackMessage = $"Error: {ex.Message}";
            addProduceFeedbackColour = "text-red-400";
            Console.WriteLine($"Error adding produce: {ex.Message}");
        }

        StateHasChanged();
    }

    private string GetProduceEmoji(string name) => name.ToLower() switch
    {
        var n when n.Contains("plum") => "🍑",
        var n when n.Contains("apple") => "🍎",
        var n when n.Contains("banana") => "🍌",
        var n when n.Contains("carrot") => "🥕",
        var n when n.Contains("tomato") => "🍅",
        var n when n.Contains("potato") => "🥔",
        var n when n.Contains("strawberr") => "🍓",
        var n when n.Contains("lettuce") => "🥬",
        var n when n.Contains("orange") => "🍊",
        var n when n.Contains("cucumber") => "🥒",
        _ => "🥦"
    };
}