@using VEGG.TABLE.Core.Entities
@inject NavigationManager Navigation

<div class="produce-card relative border border-primary/20 rounded-lg shadow-sm hover:shadow-md transition-all duration-300 p-4 bg-primary text-white flex flex-col text-center">
    
    <button @onclick="ShowLoginMsg" class="absolute top-2 right-2 p-2 hover:bg-white/10 rounded-full transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 transition-colors duration-200 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
    </button>

    @if (showLoginMsg)
    {
        <div class="absolute top-12 right-2 bg-white text-primary text-xs px-2 py-1 rounded shadow-md z-10">
            Login required
        </div>
    }

    <div class="w-full h-40 bg-white/10 rounded-md mb-3 flex items-center justify-center text-6xl">
        @GetProduceEmoji(Item.Name)
    </div>

    <h3 class="text-lg font-semibold">@Item.Name</h3>
    <p class="text-sm text-primary-50">Price: £@Item.Price</p>
    <p class="text-sm text-primary-100">In Stock: @Item.Stock</p>
    
    <button class="w-full mt-4 bg-accent hover:bg-accent-hover text-white py-2 rounded-md transition-all duration-200 active:scale-95 font-medium" 
            @onclick="ShowLoginMsg">
        Request to Buy
    </button>
</div>

@code {
    [Parameter] public Produce Item { get; set; } = default!;
    private bool showLoginMsg = false;

    // The shared method that handles the popup
    private async Task ShowLoginMsg()
    {
        showLoginMsg = true;
        StateHasChanged();
        await Task.Delay(2000);
        showLoginMsg = false;
        StateHasChanged();
    }

    private string GetProduceEmoji(string name) => name.ToLower() switch
    {
        var n when n.Contains("plum") => "🍑",
        var n when n.Contains("apple") => "🍎",
        var n when n.Contains("banana") => "🍌",
        var n when n.Contains("carrot") => "🥕",
        var n when n.Contains("tomato") => "🍅",
        var n when n.Contains("potato") => "🥔",
        var n when n.Contains("strawberry") => "🍓",
        var n when n.Contains("lettuce") => "🥬",
        var n when n.Contains("orange") => "🍊",
        var n when n.Contains("cucumber") => "🥒",
        _ => "🥦"
    };
}