@inject IJSRuntime JS

<div class="flex items-center">
    @* Container with emerald border to match navbar, using primary for active state *@
    <button @onclick="ToggleTheme" 
            class="relative w-16 h-8 border border-white/30 rounded-full p-1 transition-all duration-300 flex items-center shadow-inner 
                   @(isDark ? "bg-emerald-900" : "bg-emerald-600")">
        
        @* The sliding thumb *@
        <div class="w-6 h-6 bg-white rounded-full shadow-md transform transition-transform duration-300 ease-in-out
                    @(isDark ? "translate-x-8" : "translate-x-0") 
                    flex items-center justify-center text-sm">
            @(isDark ? "🌙" : "☀️")
        </div>
    </button>
</div>

@code {
    private bool isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDark = await JS.InvokeAsync<bool>("themeManager.initializeTheme");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("themeManager.toggleTheme", isDark);
    }
}